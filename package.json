{
  "name": "billit",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=./apps/*",
    "dev:web": "pnpm --filter @billit/web dev",
    "dev:mobile": "pnpm --filter @billit/mobile dev",
    "dev:mobile:web": "pnpm --filter @billit/mobile web",
    "lint": "turbo run lint --filter=./apps/* --filter=./packages/*",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck --filter=./apps/* --filter=./packages/*",
    "test": "turbo run test --filter=./apps/* --filter=./packages/*",
    "build": "turbo run build --filter=./apps/*"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "turbo": "^2.11.9"
  }
}
