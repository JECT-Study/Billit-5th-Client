EXPO_PUBLIC_API_URL=http://localhost:8080
# 기본값은 app.config.ts의 @jectbillit/billit 프로젝트입니다. 다른 프로젝트로 바꿀 때만 설정합니다.
# EAS_PROJECT_ID=

# 아이콘 동기화(pnpm icons:sync)용 Figma 개인 액세스 토큰. 실제 값은 .env.local에만 넣으세요.
# 발급: Figma > Settings > Security > Personal access tokens, 스코프는 "File content: Read-only"만
# 앱 코드에서 쓰는 값이 아니므로 EXPO_PUBLIC_ 접두어를 붙이지 않습니다 (붙이면 앱 번들에 포함됨)
# FIGMA_TOKEN=
